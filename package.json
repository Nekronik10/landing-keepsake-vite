    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "sass": "^1.80.4",
    "sharp": "^0.33.5",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "vite": "^5.4.10",
    "vituum": "^1.1.3"
  },
  "lint-staged": {
    "*.scss": [
