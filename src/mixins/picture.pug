mixin picture(baseName, alt, width = 800, height = 632, sizes = '(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw', lazy = true, priority = null)
  -
    const avifSrcset = `/assets/images/${baseName}-400.avif 400w, /assets/images/${baseName}-800.avif 800w`;
    const webpSrcset = `/assets/images/${baseName}-400.webp 400w, /assets/images/${baseName}-800.webp 800w`;
    const fallbackSrc = `/assets/images/${baseName}-800.svg`;
  picture
    source(type="image/avif" srcset=avifSrcset sizes=sizes)
    source(type="image/webp" srcset=webpSrcset sizes=sizes)
    if lazy
      img(src=fallbackSrc alt=alt width=width height=height loading="lazy" decoding="async")&attributes(attributes)
    else if priority
      img(src=fallbackSrc alt=alt width=width height=height fetchpriority=priority decoding="async")&attributes(attributes)
    else
      img(src=fallbackSrc alt=alt width=width height=height decoding="async")&attributes(attributes)
